# Backend origin used by the server-side auth bridge (never exposed to the browser).
BACKEND_API_URL=http://localhost:8000

# Legacy HS256 secret (kid=default). Keep while migrating to the key ring.
DASHBOARD_SESSION_SECRET=replace-with-the-backend-dashboard-session-secret

# Rotation: configure the same JSON map on backend and dashboard, set the active
# kid on backend, and retain old keys here until all claims signed by them expire.
# Example: {"k1":"<32+ chars>","k2":"<32+ chars>"}
DASHBOARD_SESSION_SECRETS=

# HttpOnly cookie names. Optional; defaults shown.
DASHBOARD_CLAIM_COOKIE=dashboard_claim
DASHBOARD_ACCESS_COOKIE=dashboard_access
DASHBOARD_REFRESH_COOKIE=dashboard_refresh
