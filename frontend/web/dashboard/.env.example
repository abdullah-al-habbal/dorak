# Laravel API origin. Only the Next.js server talks to it; the browser never does.
BACKEND_API_URL=http://localhost:8000

# Must equal the backend's DASHBOARD_SESSION_SECRET (min 32 chars). Used to verify the signed session claim.
DASHBOARD_SESSION_SECRET=

# Optional key ring for rotation: JSON {"kid":"secret"}. Takes precedence over DASHBOARD_SESSION_SECRET.
# DASHBOARD_SESSION_SECRETS={"default":"..."}
