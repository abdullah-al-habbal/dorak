# Server-side URL used by the BFF proxy. Keep this private.
DASHBOARD_API_URL=http://localhost:8000/api/v1

# Public URL used only by the landing-page health indicator.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Must exactly match the Laravel DASHBOARD_SESSION_SECRET and be at least 32 characters.
DASHBOARD_SESSION_SECRET=
