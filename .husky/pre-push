# Runs the backend gates when the pushed commits change backend/. Git passes one line per ref on stdin.
backend_changed=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # A deleted ref pushes no commits.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  base=""
  if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base=$remote_sha
  else
    base=$(git merge-base "$local_sha" origin/master 2>/dev/null || true)
  fi

  # Without a base the change set is unknown, so run the gates.
  if [ -z "$base" ] || ! git diff --quiet "$base" "$local_sha" -- backend; then
    backend_changed=1
  fi
done

[ "$backend_changed" -eq 0 ] && exit 0

echo "pre-push: backend changed; running Pint, the migration guard and the test suite."
cd backend || exit 1
./vendor/bin/pint --test || exit 1
php scripts/check_migrations.php || exit 1
composer test:db:up || exit 1
composer test
