# Local tooling and migration backups are not root coordination artifacts.
/.agents/
/.claude/*
!/.claude/skills/
!/.claude/settings.json
/.aiignore
/*.bundle

# Generated frontend artifacts and local agent caches.
/frontend/**/node_modules/
/frontend/**/.next/
/frontend/**/.agents/
/frontend/**/tsconfig.tsbuildinfo
/frontend/mobile/.dart_tool/
/frontend/mobile/build/

# OS, editor and tooling catch-alls (safety net for every subproject).
.DS_Store
Thumbs.db
.idea/
*.iml
*.swp
*.log
coverage/
graphify-out/

# Environment files: never commit secrets, only the example templates.
.env
.env.*
!.env.example
